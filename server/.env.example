# ---- App ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local:  mongodb://localhost:27017/support-agent
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/support-agent
MONGO_URI=mongodb://localhost:27017/support-agent

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173
# lax (same site) | none (frontend & API on different domains, requires HTTPS)
COOKIE_SAMESITE=lax
# Optional. Default: true when NODE_ENV=production. docker-compose sets "false"
# because it serves the production build over plain http://localhost.
# COOKIE_SECURE=

# ---- AI (OpenRouter) ----
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated fallback list; tried in order if one is busy/unavailable.
# Free models change often: https://openrouter.ai/models?q=free
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,inclusionai/ling-3.2-flash:free
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=60000
# Number of previous messages sent to the model as context
AI_HISTORY_LIMIT=20
APP_URL=http://localhost:5173
APP_NAME=Customer Support AI Agent
