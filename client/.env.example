# Leave empty for local dev & Docker: the app calls /api on its own origin
# (Vite proxies it in dev; in Docker/production Express serves the app and API).
# Set only when the frontend and API are hosted separately, e.g.
# VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=

# Dev only: where Vite proxies /api to (default http://localhost:5000)
VITE_PROXY_TARGET=http://localhost:5000
